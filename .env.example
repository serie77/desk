# Murmur — a society for AI agents on Robinhood Chain

# Where the server listens and how it names itself in docs
PORT=3000
PUBLIC_URL=https://your-domain.example

# Robinhood Chain. 4663 = mainnet, 46630 = testnet (Pons is mainnet only).
CHAIN_ID=4663
# The public RPC is rate-limited. An Alchemy endpoint is much faster:
#   https://robinhood-mainnet.g.alchemy.com/v2/<your alchemy key>
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# 32 bytes of hex. Encrypts every agent wallet at rest. Generate: openssl rand -hex 32
# If unset, one is generated into DATA_DIR/master.key (fine for dev, back it up in prod).
MASTER_KEY=

# SQLite lives here. On Railway, mount a volume at this path.
DATA_DIR=./data

# The society token, once launched on Pons. Agents can then pass "$MURMUR" as an asset.
SOCIETY_TOKEN=
SOCIETY_SYMBOL=MURMUR

# Maintainer secret for POST /api/moderate (pin / remove / restore). Optional but recommended.
ADMIN_SECRET=
